# Discord
DISCORD_BOT_TOKEN=
# Optional API-service override for mirroring web ticket activity into Discord threads.
# Falls back to DISCORD_BOT_TOKEN when both services share the same env.
TICKET_THREAD_MIRROR_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# OAuth redirect URI. In production this MUST point at the WEB origin
# (e.g. https://hansard.example/api/auth/discord/callback), not the API
# host — same-origin nginx proxies the callback through, and the Discord
# Developer Portal "Redirects" allowlist must include the same URL.
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback

# Bot display name (configurable — defaults to "Hansard")
BOT_DISPLAY_NAME=Hansard
# Set true to send reaction-vote success confirmation DMs.
# Error DMs for failed/invalid vote attempts still send.
REACTION_VOTE_CONFIRMATION_DMS=false

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/hansard

# API
API_PORT=3001
API_URL=http://localhost:3001
SESSION_SECRET=

# Web
WEB_PORT=5173
# Local dev: point at the API directly (Vite proxies /api → API server).
# Production build arg: leave empty or set to "/api" so the same-origin
# nginx reverse proxy in Dockerfile.web handles routing — eliminates the
# cross-site cookie problem (Brave + stricter browser modes were bouncing
# users back to /login after Discord OAuth).
VITE_API_URL=http://localhost:3001/api

# Runtime env on the web service in production. The nginx layer in
# Dockerfile.web reverse-proxies /api/* to this upstream so the browser
# only ever talks to the web origin (same-origin cookies).
# Railway example: API_UPSTREAM=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:3001
API_UPSTREAM=http://localhost:3001

# Discord channel config
TICKET_CHANNEL_ID=
GAME_EVENTS_CHANNEL_ID=
# Legacy alias for older deploys; GAME_EVENTS_CHANNEL_ID wins when both are set.
ANNOUNCEMENT_CHANNEL_ID=
VOTING_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=
GRAVEYARD_CHANNEL_ID=
LEGISLATION_CHANNEL_ID=
PARTY_JOIN_CHANNEL_ID=
PARTY_JOIN_MESSAGE_ID=
MESSAGE_EXPORT_CHANNEL_IDS=

# API-side Discord message export (staff-only) uses DISCORD_BOT_TOKEN
# plus MESSAGE_EXPORT_CHANNEL_IDS when enabled.

# Optional
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Staff + guild scoping (bot)
# ---------------------------------------------------------------------------
# Comma/space-separated Discord role IDs treated as staff for pings, phone
# admin checks, and ticket threads. Falls back to a role literally named "Staff".
STAFF_ROLE_IDS=
# Legacy single-role alias; merged into STAFF_ROLE_IDS when both are set.
STAFF_ROLE_ID=
# Optional: also register the slash-command set on this guild for instant
# updates during development.
DEV_GUILD_ID=
# Set when the bot is in more than one guild so phone staff checks and staff
# thread creation are pinned to a single server.
PHONE_GUILD_ID=

# ---------------------------------------------------------------------------
# Phone system (bot)
# ---------------------------------------------------------------------------
# Channel that hosts the per-pair private call/text log threads. Must not be
# visible to @everyone (the bot warns on startup if it is).
PHONE_LOG_CHANNEL_ID=
# Default destination for wiretap mirrors when a tap has no explicit target.
PHONE_TAP_CHANNEL_ID=
# Worker cadence overrides (milliseconds). Defaults: 30s active, 6h idle sweep.
# Lowering the idle interval keeps a scale-to-zero Postgres (e.g. Neon) warm
# and increases compute cost.
PHONE_RING_WORKER_INTERVAL_MS=
PHONE_RING_WORKER_IDLE_INTERVAL_MS=
PHONE_RING_WORKER_ACTIVE_WINDOW_MS=
# Vote auto-close worker cadence (milliseconds). Defaults: 60s active, 6h idle.
VOTE_AUTO_CLOSE_INTERVAL_MS=
VOTE_AUTO_CLOSE_IDLE_INTERVAL_MS=

# ---------------------------------------------------------------------------
# API extras
# ---------------------------------------------------------------------------
# Bind address for the Fastify server (default 0.0.0.0).
API_HOST=
# Pino log level (default info).
LOG_LEVEL=info
# Allowed browser origin in dev when web and API are on different ports
# (default http://localhost:5173). Irrelevant in same-origin production.
CORS_ORIGIN=
# Where the OAuth callback redirects the browser after login
# (default http://localhost:5173).
FRONTEND_URL=
# Public base URL of the API for MCP device-flow links. Set in production so
# the API does not trust the proxied Host header.
PUBLIC_API_URL=
# Optional dedicated bot tokens for API-originated Discord DMs/posts; both fall
# back to DISCORD_BOT_TOKEN.
FAVOUR_DM_BOT_TOKEN=
MOD_LOG_BOT_TOKEN=

# ---------------------------------------------------------------------------
# MCP client (packages/mcp)
# ---------------------------------------------------------------------------
HANSARD_API_URL=http://localhost:3001
# Override where the device-flow bearer token is stored.
HANSARD_MCP_TOKEN_FILE=

# ---------------------------------------------------------------------------
# Testing / maintenance scripts
# ---------------------------------------------------------------------------
# Integration tests that need a real Postgres run ONLY when this is set, and
# refuse to run if it equals DATABASE_URL. Never point it at production.
TEST_DATABASE_URL=
# Where cleanup scripts write pg_dump backups before deleting rows.
DB_BACKUP_DIR=db-backups
