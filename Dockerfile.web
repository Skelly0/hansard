FROM node:20-alpine AS build
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

# VITE_API_URL is baked in at build time (Vite inlines env vars). Defaults to
# the same-origin relative path "/api" so the production nginx layer below can
# reverse-proxy /api/* to the API service — see packages/web/nginx.conf.template
# and the API_UPSTREAM runtime env var.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

# Install dependencies
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/web/package.json packages/web/
RUN pnpm install --frozen-lockfile

# Copy source and build
COPY tsconfig.base.json ./
COPY packages/web/ packages/web/
RUN pnpm --filter @hansard/web build

# Serve with nginx + same-origin /api reverse proxy.
FROM nginx:alpine
COPY --from=build /app/packages/web/dist /usr/share/nginx/html

# Files in /etc/nginx/templates/*.template are processed by the official nginx
# image's entrypoint with envsubst, so ${API_UPSTREAM} is substituted at
# container start (set on the Railway web service to the API's internal URL).
# NGINX_LOCAL_RESOLVERS is populated from /etc/resolv.conf by the nginx:alpine
# image's /docker-entrypoint.d/15-local-resolvers.envsh so the template's
# `resolver` directive picks up the platform DNS server — needed so the upstream
# hostname is re-resolved at runtime (Railway rotates the internal IP on every
# API redeploy). That script is **opt-in**: it returns early unless
# NGINX_ENTRYPOINT_LOCAL_RESOLVERS is set to a non-empty value, otherwise the
# var stays unset, envsubst leaves the literal ${NGINX_LOCAL_RESOLVERS} in the
# rendered config, and nginx crashes at boot with "host not found in resolver".
ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
# Filter limits substitution to those two so nginx's own variables
# ($host, $scheme, etc.) cannot be accidentally clobbered by unrelated env vars.
ENV NGINX_ENVSUBST_FILTER=^(API_UPSTREAM|NGINX_LOCAL_RESOLVERS)$
COPY packages/web/nginx.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
