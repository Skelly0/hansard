{
  "name": "@hansard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./services/*": {
      "development": "./src/services/*.ts",
      "types": "./dist/services/*.d.ts",
      "import": "./dist/services/*.js",
      "default": "./dist/services/*.js"
    }
  },
  "scripts": {
    "dev": "tsx --conditions=development watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/session": "^11.0.0",
    "@hansard/db": "workspace:*",
    "@hansard/shared": "workspace:*",
    "diff": "^9.0.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
