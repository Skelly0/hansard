  "dependencies": {
    "discord.js": "^14.16.0",
    "@hansard/api": "workspace:*",
    "@hansard/db": "workspace:*",
    "@hansard/shared": "workspace:*",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.38.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
