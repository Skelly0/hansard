{
  "name": "@hansard/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "backfill:phone-threads": "tsx scripts/backfillPhoneThreads.ts",
    "backfill:ticket-thread-messages": "tsx src/scripts/backfillTicketThreadMessages.ts",
    "backfill:ticket-thread-mirrors": "tsx src/scripts/backfillTicketThreadMirrors.ts",
    "close:due-votes": "tsx src/scripts/closeDueVotes.ts",
